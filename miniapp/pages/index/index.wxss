page{background:#faf8f3}
.main-scroll{height:100vh}
.header-auth{display:flex;justify-content:flex-end;align-items:center;gap:10rpx;padding:16rpx 24rpx}
.user-badge{font-size:26rpx;color:#1f1f1f;display:flex;align-items:center;gap:8rpx}
.dot{width:12rpx;height:12rpx;border-radius:50%;background:#933;flex-shrink:0}
.btn-auth-sm{font-size:24rpx;padding:8rpx 24rpx;border-radius:32rpx;background:transparent;color:#777;border:1rpx solid #e6dfd4;line-height:1.4}
.btn-auth-primary{font-size:24rpx;padding:8rpx 24rpx;border-radius:32rpx;background:#933;color:#fff;border:1rpx solid #933;line-height:1.4}

.header{padding:60rpx 40rpx 48rpx;text-align:center;border-bottom:1rpx solid #e6dfd4;position:relative}
.header::after{content:'';position:absolute;bottom:-1rpx;left:50%;transform:translateX(-50%);width:60rpx;height:2rpx;background:#933;border-radius:1rpx}
.title{font-size:50rpx;font-weight:700;letter-spacing:10rpx}
.subtitle{font-size:26rpx;color:#777;margin-top:10rpx;letter-spacing:6rpx}
.badge{display:inline-block;margin-top:24rpx;padding:8rpx 28rpx;border:1rpx solid #e6dfd4;border-radius:40rpx;font-size:22rpx;color:#777}

.method-section{padding:32rpx 28rpx;margin:28rpx 24rpx;background:#fff;border-radius:16rpx;border:1rpx solid #e6dfd4}
.method-title{text-align:center;font-size:30rpx;font-weight:600;margin-bottom:24rpx;display:flex;align-items:center;justify-content:center;gap:16rpx}
.method-title .line{display:inline-block;width:32rpx;height:1rpx;background:#e6dfd4}
.method-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx}
.method-step{text-align:center;padding:20rpx 10rpx;background:#faf8f3;border-radius:12rpx}
.step-num{display:inline-flex;align-items:center;justify-content:center;width:44rpx;height:44rpx;background:#933;color:#fff;border-radius:50%;font-size:22rpx;margin-bottom:12rpx}
.step-title{font-weight:600;font-size:26rpx;margin-bottom:6rpx}
.step-desc{font-size:22rpx;color:#777;line-height:1.5}
.rules-note{margin-top:20rpx;padding:16rpx 20rpx;background:#faf8f3;border-radius:12rpx;font-size:22rpx;color:#777;text-align:center;line-height:1.7;border:1rpx solid #e6dfd4;white-space:pre-line}
.rules-title{font-weight:600;color:#1f1f1f}

.toss-area{padding:0 40rpx;margin:40rpx auto;text-align:center}
.toss-dots{display:flex;justify-content:center;gap:16rpx;margin-bottom:36rpx}
.toss-dot{width:72rpx;height:72rpx;border-radius:50%;border:2rpx solid #e6dfd4;display:flex;align-items:center;justify-content:center;font-size:24rpx;color:#777;background:#fff}
.toss-dot.completed{background:#1f1f1f;border-color:#1f1f1f;color:#fff}
.toss-dot.current{border-color:#933;box-shadow:0 0 0 6rpx rgba(153,51,51,0.08)}
.toss-dot.changing{position:relative}
.toss-dot.changing::after{content:'';position:absolute;top:-8rpx;right:-8rpx;width:16rpx;height:16rpx;background:#933;border-radius:50%;border:2rpx solid #fff}

.coin-display{width:180rpx;height:180rpx;margin:0 auto 32rpx}
.coin{width:100%;height:100%;position:relative;transform-style:preserve-3d;transition:transform 0.5s}
.coin.flipping{animation:flip 0.8s ease-out}
.coin.result-yang{transform:rotateY(0deg)}
.coin.result-yin{transform:rotateY(180deg)}
.face{position:absolute;width:100%;height:100%;backface-visibility:hidden;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:48rpx;box-shadow:0 4rpx 24rpx rgba(0,0,0,0.1)}
.face-label{font-size:20rpx;opacity:0.6}
.heads{background:linear-gradient(135deg,#f0d68a,#d4b85a,#b89340);color:#5c3800}
.tails{background:linear-gradient(135deg,#6b5030,#4a3520,#3a2818);color:#c8b898;transform:rotateY(180deg)}
@keyframes flip{
  0%{transform:rotateY(0)}
  25%{transform:rotateY(540deg) rotateX(25deg)}
  50%{transform:rotateY(1080deg) rotateX(-15deg)}
  75%{transform:rotateY(1620deg) rotateX(8deg)}
  100%{transform:rotateY(2160deg) rotateX(0)}
}

.coin-results{display:flex;justify-content:center;gap:16rpx;margin:20rpx 0;min-height:60rpx}
.coin-mini{width:56rpx;height:56rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:32rpx;opacity:0;transform:scale(0);transition:all 0.35s}
.coin-mini.show{opacity:1;transform:scale(1)}
.coin-mini.heads{background:#c8a45a;color:#fff}
.coin-mini.tails{background:#6b5230;color:#ddd}

.btn-toss{display:inline-flex;align-items:center;justify-content:center;padding:22rpx 70rpx;background:#933;color:#fff;border:none;border-radius:48rpx;font-size:30rpx;letter-spacing:6rpx;margin-top:8rpx}
.btn-toss[disabled]{background:#bbb}
.btn-reset{background:#5a7a6a;margin-top:32rpx}
.toss-status{margin-top:16rpx;font-size:24rpx;color:#777}

.result-section{padding:0 28rpx 40rpx}
.hex-title{text-align:center;font-size:48rpx;font-weight:700;letter-spacing:16rpx;margin-top:40rpx}
.hex-subtitle{text-align:center;font-size:24rpx;color:#777;margin-bottom:32rpx;letter-spacing:4rpx}
.hex-lines{display:flex;flex-direction:column;align-items:center;gap:6rpx;margin-bottom:24rpx}
.hex-line{display:flex;align-items:center;gap:16rpx}
.line-label{font-size:22rpx;color:#777;width:50rpx;text-align:right}
.line-bar{height:12rpx;border-radius:6rpx}
.line-bar.yang{width:200rpx;background:#1f1f1f}
.line-bar.yin{display:flex;gap:8rpx}
.yin-half{width:96rpx;height:12rpx;background:#1f1f1f;border-radius:6rpx}
.change-indicator{font-size:22rpx;color:#933;width:50rpx}
.change-info{text-align:center;font-size:24rpx;color:#777;margin-bottom:32rpx}

.interp-card{background:#fff;border:1rpx solid #e6dfd4;border-radius:16rpx;padding:28rpx;margin-bottom:18rpx}
.card-title{font-size:30rpx;font-weight:600;margin-bottom:18rpx;padding-bottom:14rpx;border-bottom:1rpx solid #e6dfd4}
.card-body{font-size:28rpx;line-height:1.9}
.label{display:inline-block;padding:2rpx 14rpx;background:#faf8f3;border-radius:8rpx;font-size:22rpx;color:#777;margin-right:8rpx;border:1rpx solid #e6dfd4}
.changing-note{padding:16rpx 20rpx;background:rgba(153,51,51,0.03);border-left:3rpx solid #933;border-radius:0 8rpx 8rpx 0;font-size:26rpx;color:#933;line-height:1.8;margin-top:12rpx}
.changing-label{font-weight:600}
.changed-hex{margin-top:32rpx;padding-top:24rpx;border-top:1rpx solid #e6dfd4}
.changed-hex .card-title{color:#5a7a6a}
.line-text{font-size:26rpx;padding:6rpx 0;line-height:1.7}
.line-highlight{color:#933;font-weight:600}

.empty-state{text-align:center;padding:100rpx 20rpx}
.bagua-row{font-size:48rpx;opacity:0.25;letter-spacing:8rpx;margin-bottom:32rpx}
.empty-text{font-size:28rpx;color:#777;line-height:2;white-space:pre-line}

.footer{text-align:center;padding:40rpx;font-size:22rpx;color:#bbb;white-space:pre-line}

/* Modal */
.modal-mask{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.4);z-index:200}
.modal-box{position:fixed;top:15%;left:40rpx;right:40rpx;background:#fff;border-radius:24rpx;padding:36rpx;z-index:201}
.wx-login-title{text-align:center;font-size:34rpx;font-weight:600;margin-bottom:12rpx}
.wx-login-desc{text-align:center;font-size:24rpx;color:#999;margin-bottom:28rpx}
.wx-login-btn{width:100%;padding:22rpx;background:#07c160;color:#fff;border:none;border-radius:16rpx;font-size:30rpx;font-weight:500;letter-spacing:4rpx}
.wx-login-cancel{text-align:center;margin-top:20rpx;font-size:24rpx;color:#bbb}

/* Drawer */
.drawer-mask{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.3);z-index:150}
.drawer{position:fixed;top:0;left:0;width:520rpx;height:100%;background:#1c1915;z-index:151;transform:translateX(-100%);transition:transform 0.3s}
.drawer.open{transform:translateX(0)}
.drawer-header{padding:40rpx 32rpx 28rpx;border-bottom:1rpx solid rgba(255,255,255,0.06)}
.drawer-title{color:#d4c5b0;font-size:34rpx;font-weight:600;display:flex;align-items:center;gap:12rpx}
.drawer-title::before{content:'';display:inline-block;width:6rpx;height:28rpx;background:#933;border-radius:3rpx}
.drawer-subtitle{color:rgba(255,255,255,0.25);font-size:22rpx;margin-top:8rpx}
.drawer-locked{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:120rpx 40rpx;text-align:center;gap:28rpx}
.locked-text{color:rgba(255,255,255,0.2);font-size:26rpx;line-height:2;white-space:pre-line}
.drawer-user-row{display:flex;align-items:center;gap:16rpx;padding:20rpx 28rpx;border-bottom:1rpx solid rgba(255,255,255,0.06)}
.user-avatar{width:50rpx;height:50rpx;border-radius:50%;background:#933;color:#fff;display:flex;align-items:center;justify-content:center;font-size:24rpx;font-weight:600}
.user-name{color:#c8b898;font-size:28rpx;flex:1}
.btn-logout{font-size:22rpx;padding:4rpx 16rpx;border-radius:20rpx;background:transparent;color:rgba(255,255,255,0.3);border:1rpx solid rgba(255,255,255,0.1);line-height:1.4}
.drawer-list{flex:1;padding:16rpx 20rpx;overflow-y:auto}
.history-empty{text-align:center;color:rgba(255,255,255,0.2);font-size:24rpx;padding:80rpx 0;line-height:2;white-space:pre-line}
.history-item{padding:20rpx;margin-bottom:10rpx;border-radius:12rpx;border:1rpx solid transparent;position:relative}
.history-item.active{background:rgba(255,255,255,0.06);border-color:rgba(255,255,255,0.06)}
.hi-date{font-size:20rpx;color:rgba(255,255,255,0.25);margin-bottom:4rpx}
.hi-name{font-size:28rpx;color:#c8b898;font-weight:600}
.hi-summary{font-size:22rpx;color:rgba(255,255,255,0.3);margin-top:4rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.hi-del{position:absolute;top:16rpx;right:18rpx;font-size:28rpx;color:rgba(255,255,255,0.15)}
.drawer-footer{padding:20rpx 28rpx;border-top:1rpx solid rgba(255,255,255,0.06)}
.btn-clear{width:100%;padding:16rpx;border-radius:12rpx;background:transparent;color:rgba(255,255,255,0.25);border:1rpx solid rgba(255,255,255,0.06);font-size:24rpx}

.float-btn{position:fixed;left:24rpx;bottom:120rpx;width:72rpx;height:72rpx;border-radius:50%;background:#1c1915;color:#b8976a;display:flex;align-items:center;justify-content:center;font-size:36rpx;z-index:100;box-shadow:0 4rpx 20rpx rgba(0,0,0,0.2)}

.toast{position:fixed;top:30rpx;left:50%;transform:translateX(-50%) translateY(-120rpx);background:#1f1f1f;color:#fff;padding:16rpx 36rpx;border-radius:40rpx;font-size:26rpx;z-index:300;transition:transform 0.3s}
.toast-show{transform:translateX(-50%) translateY(0)}